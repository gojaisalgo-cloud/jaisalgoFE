NEXT_PUBLIC_SITE_URL=https://www.jaisalgo.com
# Optional: the real token from your Google Search Console URL-prefix property.
# A Domain property instead uses DNS TXT verification; never put DNS credentials here.
GOOGLE_SITE_VERIFICATION=
# Optional genuine Bing Webmaster Tools HTML verification token.
BING_SITE_VERIFICATION=
# Optional GA4 public measurement ID. Loads only after the existing analytics opt-in.
# Disable Enhanced Measurement in GA4; this adapter sends sanitized public-page views only.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Enable only after disabling automatic/Enhanced Measurement in the property.
NEXT_PUBLIC_GA4_ENABLED=false
# Leave blank until a verified business contact is available.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# HTTPS webhook accepting validated JSON, returning 2xx only after durable acceptance.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=

# live (default; fails closed without configuration), test, or explicit demo for development only
BOOKING_MODE=live
# Default traveler capacity per package/date: 1–100, or unlimited for open reservations.
# Leave empty to require individual departure capacity. Explicit date overrides take priority.
BOOKING_DEFAULT_CAPACITY=
# Local development defaults to .data/jaisalgo.db.
# REQUIRED on Vercel: a shared remote libSQL URL and auth token.
# File paths, /tmp and in-memory databases are rejected on Vercel.
# Until connected, packages remain browsable and online payments are unavailable.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are also supported as aliases.
# Configure with npm run admin:setup. Never commit real values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BOOKING_BUSINESS_NAME=

# Optional first-party anonymous analytics, offered only with consent.
ANALYTICS_ENABLED=true
# Safe campaign identifiers only, comma-separated. Unknown values aggregate as other.
ANALYTICS_CAMPAIGNS=
# Verified authentic proof identifiers only. Empty means no proof exposure events accepted.
ANALYTICS_AUTHENTIC_PROOF_IDS=

# Optional PostHog. Public project token only; never use a personal API key here.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Exactly https://us.i.posthog.com or https://eu.i.posthog.com, matching your project.
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_ENABLED=true
# Set explicitly per hosting environment: production, preview or development.
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=development
# Public-page replay only, all text/attributes masked; no private booking/ticket recording.
NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE_RATE=0.1
# Approved safe marketing IDs. Unknown query values become "other"; raw queries never ship.
NEXT_PUBLIC_POSTHOG_ALLOWED_CAMPAIGNS=
NEXT_PUBLIC_POSTHOG_ALLOWED_CONTENT=
NEXT_PUBLIC_POSTHOG_ALLOWED_TERMS=

# Private operational group alerts, sent only after verified live payment capture.
# GREEN-API linked WhatsApp sender must already belong to the chosen group.
WHATSAPP_API_URL=
WHATSAPP_INSTANCE_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_GROUP_ID=
WHATSAPP_GROUP_INVITE_URL=
# Optional protected retry endpoint: /api/internal/booking-alerts
CRON_SECRET=

# Google Identity Services: a Web OAuth client with the exact site origins registered.
# This public identifier is also checked server-side; no OAuth client secret is needed.
GOOGLE_CLIENT_ID=
# Sends a single consented new-user alert to the existing private WhatsApp group.
# Enable only on the intended production environment, not local previews.
CUSTOMER_SIGNUP_ALERTS_ENABLED=false
